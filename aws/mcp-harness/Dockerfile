# FinChat MCP harness — a container image Lambda that calls the MCP endpoint from AWS.
#
# A container rather than a zip because the ask was "an image running in AWS", and
# because the mcp SDK plus google-auth is past the comfortable size for inline editing.
# ECR storage is the only standing cost: roughly $0.03/month for this image. A zip
# package would be exactly $0 if that matters more than the image.
#
#   docker build -t finchat-mcp-harness aws/mcp-harness
FROM public.ecr.aws/lambda/python:3.12

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY handler.py ${LAMBDA_TASK_ROOT}/

# The credential configuration. It contains NO secret — it describes how to exchange this
# Lambda's execution role for a Google token, so baking it into the image is safe; the
# role is what has to be protected. Generated by deploy.sh before the build.
COPY aws-credentials.json /var/task/aws-credentials.json
ENV GOOGLE_APPLICATION_CREDENTIALS=/var/task/aws-credentials.json

CMD ["handler.lambda_handler"]
