# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
# NOTE: .terraform.lock.hcl is intentionally committed (provider pinning).

# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/
.env
*.egg-info/
.pytest_cache/

# Node / UI
node_modules/
dist/
build/
.vite/
*.local

# GCP / secrets
*-key.json
*-sa.json
service-account*.json
adc.json
.gcloud/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# scratch: API discovery dumps
disc*.json
car.json

# Canary run artifact — the baseline is committed deliberately, the latest run is not.
eval/reports/canary_latest.json

# Managed-eval run artifact (ADR-0015). Same reasoning, one degree stronger: this scores a
# LIVE agent with a judge, so it changes on every run even against an unchanged revision,
# and it carries per-case tool trajectories and the judge's reasoning on failures. A
# committed copy would be a stale scorecard that reads as authoritative.
eval/reports/vertex_latest.json

# Platform docs corpus is regenerated by setup_platform_rag.sh; large and derived.
products/transactions/agent/kb/repo_corpus.jsonl

# Generated per-environment by aws/mcp-harness/deploy.sh. It holds no secret —
# it describes how to exchange an AWS role for a Google token — but it is a build
# artifact that names one environment, so it is regenerated rather than committed.
aws/mcp-harness/aws-credentials.json

# Tracing module, staged into each service's build context by build-deploy.yml
# (ADR-0035). observability/tracing.py is the only copy that is committed — a service
# with its own copy is a content control with its own version of itself.
ui/tracing.py
products/transactions/agent/tracing.py
products/transactions/api/tracing.py
products/loans/api/tracing.py
products/process/api/tracing.py
